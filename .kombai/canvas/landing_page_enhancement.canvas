      "html": "\n<div class=\"min-h-[800px] bg-[#020617] text-white font-sans selection:bg-[#00ffff] selection:text-black overflow-x-hidden\" data-kid=\"0\">\n    \n    <header class=\"absolute top-0 left-0 right-0 z-50 border-b border-white/5 bg-transparent\" data-kid=\"1\">\n        <div class=\"max-w-7xl mx-auto px-6 h-24 flex items-center justify-between\" data-kid=\"2\">\n            <div class=\"flex items-center gap-3\" data-kid=\"3\">\n                <div class=\"w-10 h-10 bg-gradient-to-tr from-[#00ffff] to-[#008080] rounded-xl flex items-center justify-center shadow-[0_0_15px_rgba(0,255,255,0.3)]\" data-kid=\"4\">\n                    <i class=\"ti ti-tent text-black text-xl\" data-kid=\"5\"></i>\n                </div>\n                <span class=\"font-montserrat font-black text-2xl tracking-tighter uppercase\" data-kid=\"6\">Bal Pradarshani</span>\n            </div>\n            <nav class=\"hidden md:flex items-center gap-8\" data-kid=\"7\">\n                <a href=\"#\" class=\"text-sm font-bold text-white/60 hover:text-[#00ffff] hover:drop-shadow-[0_0_8px_rgba(0,255,255,0.4)] transition-all\" data-kid=\"8\">PORTAL GUIDE</a>\n                <a href=\"#\" class=\"text-sm font-bold text-white/60 hover:text-[#00ffff] hover:drop-shadow-[0_0_8px_rgba(0,255,255,0.4)] transition-all\" data-kid=\"9\">SUPPORT</a>\n                <a href=\"#\" class=\"px-6 py-2.5 bg-white/5 border border-white/10 rounded-full text-sm font-bold hover:bg-white/10 transition-all\" data-kid=\"10\">SIGN IN</a>\n            </nav>\n        </div>\n    </header>\n\n    \n    <section class=\"relative min-h-[800px] flex items-center pt-20 overflow-hidden\" data-kid=\"11\">\n        \n        <div class=\"absolute right-0 top-0 w-3/5 h-full z-0 pointer-events-none\" style=\"clip-path: polygon(25% 0, 100% 0, 100% 100%, 0% 100%);\" data-kid=\"12\">\n            <video src=\"https://videos.pexels.com/video-files/34147393/14478053_640_360_30fps.mp4\" poster=\"https://images.pexels.com/videos/34147393/pexels-photo-34147393.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline class=\"w-full h-full object-cover opacity-40 grayscale-[0.3]\" data-kid=\"13\"></video>\n            \n            <div class=\"absolute inset-0 bg-gradient-to-r from-[#020617] via-transparent to-transparent\" data-kid=\"14\"></div>\n            <div class=\"absolute inset-0 bg-gradient-to-t from-[#020617] via-transparent to-transparent\" data-kid=\"15\"></div>\n        </div>\n\n        <div class=\"max-w-7xl mx-auto px-6 w-full relative z-10\" data-kid=\"16\">\n            <div class=\"max-w-2xl\" data-kid=\"17\">\n                <div class=\"inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-black uppercase tracking-[0.2em] mb-8\" data-kid=\"18\">\n                    <span class=\"w-2 h-2 rounded-full bg-cyan-400 animate-pulse\" data-kid=\"19\"></span>\n                    60th Maharashtra Samagam 2027\n                </div>\n                <h1 class=\"text-[5.5rem] leading-[0.85] font-black font-montserrat tracking-tighter mb-8\" data-kid=\"20\">\n                    <span class=\"block opacity-80\" data-kid=\"21\">BAL</span>\n                    <span class=\"block text-white mb-2\" style=\"-webkit-text-stroke: 1px rgba(255,255,255,0.1);\" data-kid=\"22\">PRADARSHANI</span>\n                    <span class=\"block text-[#00ffff] drop-shadow-[0_0_40px_rgba(0,255,255,0.6)] animate-pulse\" data-kid=\"23\">ID GENERATION</span>\n                    <span class=\"block text-white/90\" data-kid=\"24\">PORTAL</span>\n                </h1>\n                <p class=\"text-blue-100/60 text-xl font-medium max-w-lg leading-relaxed mb-12 font-jakarta\" data-kid=\"25\">\n                    Empowering Model Heads with a seamless, high-velocity digital framework for volunteer registration and ID management.\n                </p>\n                <div class=\"flex flex-wrap gap-5\" data-kid=\"26\">\n                    <button class=\"group relative px-10 py-5 bg-[#00ffff] text-black font-black rounded-full transition-all hover:scale-105 hover:shadow-[0_0_30px_rgba(0,255,255,0.4)] overflow-hidden\" data-kid=\"27\">\n                        <span class=\"relative z-10 flex items-center gap-2\" data-kid=\"28\">\n                            START REGISTRATION <i class=\"ti ti-arrow-right text-xl group-hover:translate-x-1 transition-transform\" data-kid=\"29\"></i>\n                        </span>\n                    </button>\n                    <button class=\"px-10 py-5 bg-white/5 border border-white/10 text-white font-bold rounded-full backdrop-blur-md hover:bg-white/10 transition-all\" data-kid=\"30\">\n                        VIEW TUTORIAL\n                    </button>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section class=\"py-32 bg-gradient-to-b from-[#020617] to-[#003d33] relative\" data-kid=\"31\">\n        \n        <div class=\"absolute top-0 right-0 w-[500px] h-[500px] bg-cyan-500/5 rounded-full blur-[120px]\" data-kid=\"32\"></div>\n        <div class=\"absolute bottom-0 left-0 w-[500px] h-[500px] bg-purple-500/5 rounded-full blur-[120px]\" data-kid=\"33\"></div>\n\n        <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"34\">\n            <div class=\"mb-24 text-center\" data-kid=\"35\">\n                <h2 class=\"text-4xl md:text-6xl font-black font-montserrat uppercase tracking-tighter mb-6 text-white drop-shadow-[0_0_15px_rgba(255,255,255,0.1)]\" data-kid=\"36\">The Tremendous Journey</h2>\n                <p class=\"text-cyan-400/40 text-xl font-jakarta max-w-2xl mx-auto font-medium\" data-kid=\"37\">Follow these four high-velocity steps to secure your official volunteer badges.</p>\n            </div>\n\n            <div class=\"grid md:grid-cols-2 gap-12 relative\" data-kid=\"38\">\n                \n                <div class=\"group relative bg-white/[0.03] backdrop-blur-3xl border border-white/10 rounded-[3rem] p-12 h-[380px] flex flex-col justify-end overflow-hidden transition-all duration-500 hover:border-[#00ffff]/70 hover:bg-white/[0.07] hover:-translate-y-3 hover:shadow-[0_0_50px_rgba(0,255,255,0.15)]\" data-kid=\"39\">\n                    <div class=\"absolute -right-12 -top-12 opacity-5 group-hover:opacity-30 transition-all duration-700 group-hover:rotate-12\" data-kid=\"40\">\n                        <i class=\"ti ti-key text-[18rem]\" data-kid=\"41\"></i>\n                    </div>\n                    <div class=\"relative z-10\" data-kid=\"42\">\n                        <div class=\"w-16 h-16 rounded-2xl bg-cyan-500/10 flex items-center justify-center mb-8 border border-cyan-500/20 shadow-[inset_0_0_20px_rgba(0,255,255,0.1)] group-hover:scale-110 transition-transform\" data-kid=\"43\">\n                            <i class=\"ti ti-key text-3xl text-cyan-400\" data-kid=\"44\"></i>\n                        </div>\n                        <h3 class=\"text-3xl font-black mb-4 font-montserrat\" data-kid=\"45\">01. SECURE LOGIN</h3>\n                        <p class=\"text-blue-100/50 text-lg font-jakarta leading-relaxed\" data-kid=\"46\">Access the portal using your authorized Model Head credentials to initiate the process.</p>\n                    </div>\n                    <div class=\"absolute bottom-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-cyan-400/0 to-transparent group-hover:via-cyan-400 transition-all duration-700\" data-kid=\"47\"></div>\n                </div>\n\n                \n                <div class=\"group relative mt-12 bg-white/[0.03] backdrop-blur-3xl border border-white/10 rounded-[3rem] p-12 h-[380px] flex flex-col justify-end overflow-hidden transition-all duration-500 hover:border-[#ff00ff]/70 hover:bg-white/[0.07] hover:-translate-y-3 hover:shadow-[0_0_50px_rgba(255,0,255,0.15)]\" data-kid=\"48\">\n                    <div class=\"absolute -left-12 -top-12 opacity-5 group-hover:opacity-30 transition-all duration-700 group-hover:-rotate-12\" data-kid=\"49\">\n                        <i class=\"ti ti-users-plus text-[18rem]\" data-kid=\"50\"></i>\n                    </div>\n                    <div class=\"relative z-10\" data-kid=\"51\">\n                        <div class=\"w-16 h-16 rounded-2xl bg-purple-500/10 flex items-center justify-center mb-8 border border-purple-500/20 shadow-[inset_0_0_20px_rgba(255,0,255,0.1)] group-hover:scale-110 transition-transform\" data-kid=\"52\">\n                            <i class=\"ti ti-users-plus text-3xl text-purple-400\" data-kid=\"53\"></i>\n                        </div>\n                        <h3 class=\"text-3xl font-black mb-4 font-montserrat uppercase\" data-kid=\"54\">02. Data Entry</h3>\n                        <p class=\"text-blue-100/50 text-lg font-jakarta leading-relaxed\" data-kid=\"55\">Input volunteer profile details and upload official identification photos for verification.</p>\n                    </div>\n                    <div class=\"absolute bottom-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-purple-400/0 to-transparent group-hover:via-purple-400 transition-all duration-700\" data-kid=\"56\"></div>\n                </div>\n\n                \n                <div class=\"group relative -mt-12 bg-white/[0.03] backdrop-blur-3xl border border-white/10 rounded-[3rem] p-12 h-[380px] flex flex-col justify-end overflow-hidden transition-all duration-500 hover:border-[#00ffff]/70 hover:bg-white/[0.07] hover:-translate-y-3 hover:shadow-[0_0_50px_rgba(0,255,255,0.15)]\" data-kid=\"57\">\n                    <div class=\"absolute -right-12 -bottom-12 opacity-5 group-hover:opacity-30 transition-all duration-700 group-hover:scale-110\" data-kid=\"58\">\n                        <i class=\"ti ti-circle-check text-[18rem]\" data-kid=\"59\"></i>\n                    </div>\n                    <div class=\"relative z-10\" data-kid=\"60\">\n                        <div class=\"w-16 h-16 rounded-2xl bg-cyan-500/10 flex items-center justify-center mb-8 border border-cyan-500/20 shadow-[inset_0_0_20px_rgba(0,255,255,0.1)] group-hover:scale-110 transition-transform\" data-kid=\"61\">\n                            <i class=\"ti ti-circle-check text-3xl text-cyan-400\" data-kid=\"62\"></i>\n                        </div>\n                        <h3 class=\"text-3xl font-black mb-4 font-montserrat uppercase\" data-kid=\"63\">03. Verification</h3>\n                        <p class=\"text-blue-100/50 text-lg font-jakarta leading-relaxed\" data-kid=\"64\">Wait for the Super Admin to review and validate the submitted volunteer profiles for approval.</p>\n                    </div>\n                    <div class=\"absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-cyan-400/0 to-transparent group-hover:via-cyan-400 transition-all duration-700\" data-kid=\"65\"></div>\n                </div>\n\n                \n                <div class=\"group relative bg-white/[0.03] backdrop-blur-3xl border border-white/10 rounded-[3rem] p-12 h-[380px] flex flex-col justify-end overflow-hidden transition-all duration-500 hover:border-[#ff00ff]/70 hover:bg-white/[0.07] hover:-translate-y-3 hover:shadow-[0_0_50px_rgba(255,0,255,0.15)]\" data-kid=\"66\">\n                    <div class=\"absolute -left-12 -bottom-12 opacity-5 group-hover:opacity-30 transition-all duration-700 group-hover:rotate-6\" data-kid=\"67\">\n                        <i class=\"ti ti-credit-card text-[18rem]\" data-kid=\"68\"></i>\n                    </div>\n                    <div class=\"relative z-10\" data-kid=\"69\">\n                        <div class=\"w-16 h-16 rounded-2xl bg-purple-500/10 flex items-center justify-center mb-8 border border-purple-500/20 shadow-[inset_0_0_20px_rgba(255,0,255,0.1)] group-hover:scale-110 transition-transform\" data-kid=\"70\">\n                            <i class=\"ti ti-credit-card text-3xl text-purple-400\" data-kid=\"71\"></i>\n                        </div>\n                        <h3 class=\"text-3xl font-black mb-4 font-montserrat uppercase\" data-kid=\"72\">04. CARD PRINTING</h3>\n                        <p class=\"text-blue-100/50 text-lg font-jakarta leading-relaxed\" data-kid=\"73\">Once approved, the system generates high-quality ID badges ready for distribution.</p>\n                    </div>\n                    <div class=\"absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-purple-400/0 to-transparent group-hover:via-purple-400 transition-all duration-700\" data-kid=\"74\"></div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section class=\"py-40 px-6 md:px-12 bg-transparent overflow-hidden\" data-kid=\"75\">\n        <div class=\"max-w-7xl mx-auto relative group\" data-kid=\"76\">\n            \n            <div class=\"absolute inset-0 bg-cyan-400/10 rounded-[4rem] -rotate-2 translate-y-6 scale-[1.03]\" style=\"clip-path: polygon(0 15%, 100% 0, 100% 85%, 0% 100%);\" data-kid=\"77\"></div>\n            \n            <div class=\"relative bg-gradient-to-br from-[#d900d9] via-[#800080] to-[#4b0082] rounded-[4rem] overflow-hidden transition-transform duration-500 hover:scale-[1.005]\" style=\"clip-path: polygon(0 15%, 100% 0, 100% 85%, 0% 100%);\" data-kid=\"78\">\n                \n                <div class=\"absolute inset-0 bg-gradient-to-tr from-[#020617]/60 via-transparent to-transparent\" data-kid=\"79\"></div>\n                <div class=\"absolute -top-32 -right-32 w-[600px] h-[600px] bg-cyan-400/20 rounded-full blur-[150px] group-hover:scale-125 transition-transform duration-1000\" data-kid=\"80\"></div>\n                \n                <div class=\"relative z-10 py-40 px-12 flex flex-col items-center text-center\" data-kid=\"81\">\n                    <h2 class=\"text-6xl md:text-8xl font-black text-white font-montserrat tracking-tighter uppercase leading-[0.95] mb-12\" data-kid=\"82\">\n                        JOIN THE <br data-kid=\"83\"> \n                        <span class=\"text-cyan-400/30\" style=\"-webkit-text-stroke: 1px rgba(0,255,255,0.1);\" data-kid=\"84\">TREMENDOUS</span> WAVE\n                    </h2>\n                    <p class=\"text-white/90 text-xl font-jakarta max-w-2xl mb-12 leading-relaxed\" data-kid=\"85\">\n                        The 60th Maharashtra Samagam awaits. Start your registration journey today and be part of this divine legacy.\n                    </p>\n                    <button class=\"px-16 py-7 bg-[#00ffff] text-black text-2xl font-black rounded-full shadow-[0_20px_80px_rgba(0,255,255,0.6)] transition-all duration-300 hover:scale-110 active:scale-95 uppercase tracking-tighter\" data-kid=\"86\">\n                        START THE PROCESS\n                    </button>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <footer class=\"py-24 border-t border-white/5 bg-[#010411]\" data-kid=\"87\">\n        <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"88\">\n            <div class=\"grid md:grid-cols-4 gap-12 mb-16\" data-kid=\"89\">\n                <div class=\"md:col-span-2\" data-kid=\"90\">\n                    <div class=\"flex items-center gap-3 mb-8\" data-kid=\"91\">\n                        <div class=\"w-8 h-8 bg-[#00ffff] rounded-lg flex items-center justify-center\" data-kid=\"92\">\n                            <i class=\"ti ti-tent text-black text-sm\" data-kid=\"93\"></i>\n                        </div>\n                        <span class=\"font-montserrat font-black text-xl tracking-tighter uppercase\" data-kid=\"94\">Bal Pradarshani</span>\n                    </div>\n                    <p class=\"text-blue-100/30 text-lg font-jakarta leading-relaxed max-w-sm\" data-kid=\"95\">\n                        Official ID Generation Portal for the 60th Maharashtra Samagam 2027. Dedicated to service and devotion.\n                    </p>\n                </div>\n                <div data-kid=\"96\">\n                    <h4 class=\"text-white font-black font-montserrat uppercase tracking-wider mb-6\" data-kid=\"97\">Quick Links</h4>\n                    <ul class=\"space-y-4 text-blue-100/40 font-jakarta font-semibold\" data-kid=\"98\">\n                        <li data-kid=\"99\"><a href=\"#\" class=\"hover:text-[#00ffff] transition-colors\" data-kid=\"100\">Home Portal</a></li>\n                        <li data-kid=\"101\"><a href=\"#\" class=\"hover:text-[#00ffff] transition-colors\" data-kid=\"102\">Process Guide</a></li>\n                        <li data-kid=\"103\"><a href=\"#\" class=\"hover:text-[#00ffff] transition-colors\" data-kid=\"104\">FAQ</a></li>\n                        <li data-kid=\"105\"><a href=\"#\" class=\"hover:text-[#00ffff] transition-colors\" data-kid=\"106\">Contact Admin</a></li>\n                    </ul>\n                </div>\n                <div data-kid=\"107\">\n                    <h4 class=\"text-white font-black font-montserrat uppercase tracking-wider mb-6\" data-kid=\"108\">Connect</h4>\n                    <div class=\"flex gap-4\" data-kid=\"109\">\n                        <a href=\"#\" class=\"w-12 h-12 rounded-full bg-white/5 flex items-center justify-center hover:bg-[#00ffff] hover:text-black transition-all\" data-kid=\"110\">\n                            <i class=\"ti ti-brand-facebook text-xl\" data-kid=\"111\"></i>\n                        </a>\n                        <a href=\"#\" class=\"w-12 h-12 rounded-full bg-white/5 flex items-center justify-center hover:bg-[#00ffff] hover:text-black transition-all\" data-kid=\"112\">\n                            <i class=\"ti ti-brand-twitter text-xl\" data-kid=\"113\"></i>\n                        </a>\n                        <a href=\"#\" class=\"w-12 h-12 rounded-full bg-white/5 flex items-center justify-center hover:bg-[#00ffff] hover:text-black transition-all\" data-kid=\"114\">\n                            <i class=\"ti ti-brand-instagram text-xl\" data-kid=\"115\"></i>\n                        </a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"pt-12 border-t border-white/5 flex flex-col md:flex-row items-center justify-between gap-6 text-blue-100/20 text-sm font-bold tracking-widest uppercase\" data-kid=\"116\">\n                <p data-kid=\"117\">© 2027 SANT NIRANKARI MANDAL. ALL RIGHTS RESERVED.</p>\n                <div class=\"flex items-center gap-6\" data-kid=\"118\">\n                    <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"119\">Privacy Policy</a>\n                    <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"120\">Terms of Service</a>\n                </div>\n            </div>\n        </div>\n    </footer>\n\n    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"121\">\n    <style data-kid=\"122\">\n        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');\n        \n        body {\n            background-color: #020617;\n        }\n\n        .font-montserrat { font-family: 'Montserrat', sans-serif; }\n        .font-jakarta { font-family: 'Plus Jakarta Sans', sans-serif; }\n\n        /* Custom glow animation */\n        @keyframes flow {\n            0% { transform: translateY(0) scale(1); }\n            50% { transform: translateY(-10px) scale(1.05); }\n            100% { transform: translateY(0) scale(1); }\n        }\n\n        .animate-flow {\n            animation: flow 10s ease-in-out infinite;\n        }\n    </style>\n</div>\n",

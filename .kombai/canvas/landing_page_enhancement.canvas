      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&family=Inter:wght@400;500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .font-quicksand { font-family: 'Quicksand', sans-serif; }\n  .font-inter { font-family: 'Inter', sans-serif; }\n\n  /* Custom animation for glowing orbs */\n  @keyframes float {\n    0%, 100% { transform: translateY(0) scale(1); }\n    50% { transform: translateY(-20px) scale(1.05); }\n  }\n  .animate-float { animation: float 8s ease-in-out infinite; }\n\n  /* Smooth reveal for cards */\n  .step-card {\n    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);\n  }\n  .step-card:hover {\n    transform: translateY(-16px) scale(1.02);\n    box-shadow: 0 25px 50px -12px rgba(255, 135, 135, 0.15);\n  }\n</style>\n\n<div class=\"bg-gradient-to-tr from-[#fff4e6] via-[#fffbeb] to-[#fff4e6] text-[#343a40] font-inter selection:bg-[#ff8787]/30\" data-kid=\"1\">\n    \n    \n    <nav class=\"relative z-[100] bg-white/60 backdrop-blur-xl border-b border-white/40 px-6 py-4\" data-kid=\"2\">\n        <div class=\"max-w-7xl mx-auto flex items-center justify-between\" data-kid=\"3\">\n            <div class=\"flex items-center gap-3 group cursor-pointer\" data-kid=\"4\">\n                <div class=\"w-10 h-10 rounded-xl bg-gradient-to-br from-[#ff8787] to-[#fcc419] flex items-center justify-center shadow-lg shadow-[#ff8787]/20 group-hover:rotate-12 transition-transform\" data-kid=\"5\">\n                    <i class=\"ti ti-sparkles text-white text-xl\" data-kid=\"6\"></i>\n                </div>\n                <span class=\"font-quicksand font-bold text-2xl text-[#343a40] tracking-tight\" data-kid=\"7\">Bal Pradarshani</span>\n            </div>\n            \n            <div class=\"hidden md:flex items-center gap-8\" data-kid=\"8\">\n                <a href=\"#\" class=\"text-[#343a40]/60 hover:text-[#ff8787] font-semibold transition-colors\" data-kid=\"9\">Home</a>\n                <a href=\"#\" class=\"text-[#343a40]/60 hover:text-[#ff8787] font-semibold transition-colors\" data-kid=\"10\">Guidelines</a>\n                <a href=\"#\" class=\"text-[#343a40]/60 hover:text-[#ff8787] font-semibold transition-colors\" data-kid=\"11\">Support</a>\n            </div>\n\n            <button class=\"px-8 py-2.5 bg-[#343a40] text-white rounded-full font-bold hover:bg-[#ff8787] transition-all hover:shadow-lg hover:shadow-[#ff8787]/30 transform active:scale-95\" data-kid=\"12\">\n                Sign In\n            </button>\n        </div>\n    </nav>\n\n    \n    <header class=\"relative pt-16 pb-20 overflow-hidden\" data-kid=\"13\">\n        \n        <div class=\"absolute top-[-10%] left-[-5%] w-[600px] h-[600px] bg-[#ff8787]/10 rounded-full blur-[120px] animate-float\" data-kid=\"14\"></div>\n        <div class=\"absolute bottom-[10%] right-[-5%] w-[700px] h-[700px] bg-[#fcc419]/10 rounded-full blur-[150px] animate-float\" style=\"animation-delay: -4s\" data-kid=\"15\"></div>\n        <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-white/30 rounded-full blur-[100px] pointer-events-none\" data-kid=\"16\"></div>\n\n        <div class=\"max-w-5xl mx-auto px-6 text-center relative z-10\" data-kid=\"17\">\n            \n            <div class=\"inline-block mb-10\" data-kid=\"18\">\n                <div class=\"px-10 py-3 rounded-full border-2 border-dashed border-[#ff8787]/40 bg-white/80 backdrop-blur-md shadow-sm\" data-kid=\"19\">\n                    <span class=\"text-[#ff8787] font-bold text-xs uppercase tracking-[0.3em] font-quicksand\" data-kid=\"20\">60th Maharashtra Samagam 2027</span>\n                </div>\n            </div>\n\n            \n            <h1 class=\"text-6xl md:text-8xl font-quicksand font-light text-[#343a40] leading-[1.1] mb-8 drop-shadow-md\" data-kid=\"21\">\n                How to Use the <br data-kid=\"22\">\n                <span class=\"font-bold bg-gradient-to-r from-[#e03131] via-[#f08c00] to-[#e03131] bg-clip-text text-transparent bg-[length:200%_auto] animate-[gradient_8s_linear_infinite] drop-shadow-sm\" data-kid=\"23\">\n                    ID Generation Portal\n                </span>\n            </h1>\n\n            <p class=\"text-xl md:text-2xl text-[#343a40]/80 max-w-2xl mx-auto font-medium leading-relaxed\" data-kid=\"24\">\n                A simple 4-step guide for Model Heads to register their volunteers and get official event badges!\n            </p>\n\n            \n            <div class=\"absolute -top-10 -left-10 text-[#ff8787]/20 text-6xl rotate-12\" data-kid=\"25\">\n                <i class=\"ti ti-sparkles\" data-kid=\"26\"></i>\n            </div>\n            <div class=\"absolute -bottom-10 -right-10 text-[#fcc419]/20 text-5xl -rotate-12\" data-kid=\"27\">\n                <i class=\"ti ti-sparkles\" data-kid=\"28\"></i>\n            </div>\n        </div>\n    </header>\n\n    \n    <section class=\"py-20 relative\" data-kid=\"29\">\n        <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"30\">\n            \n            \n            <div class=\"absolute top-[55%] left-0 w-full h-40 -translate-y-1/2 opacity-40 pointer-events-none hidden lg:block overflow-hidden\" data-kid=\"31\">\n                <svg viewBox=\"0 0 1400 120\" class=\"w-full h-full stroke-[#ff8787]/60 fill-none stroke-[4]\" stroke-dasharray=\"16,16\" data-kid=\"32\">\n                    <path d=\"M-50,60 C200,120 400,0 700,60 C1000,120 1200,0 1450,60\" data-kid=\"33\"></path>\n                </svg>\n            </div>\n\n            <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-0 relative z-10\" data-kid=\"34\">\n                \n                <div class=\"lg:px-2 lg:-mr-8\" data-kid=\"35\">\n                    <div class=\"step-card h-[460px] bg-white rounded-[140px_40px_140px_40px] border-2 border-dashed border-[#ff8787] shadow-xl shadow-[#ff8787]/5 p-10 flex flex-col items-center text-center\" data-kid=\"36\">\n                        <div class=\"w-20 h-20 rounded-full bg-[#ff8787]/5 flex items-center justify-center mb-8 group-hover:bg-[#ff8787]/10 transition-colors\" data-kid=\"37\">\n                            <i class=\"ti ti-login-2 text-4xl text-[#ff8787]\" data-kid=\"38\"></i>\n                        </div>\n                        <span class=\"text-[#ff8787] font-bold text-xs tracking-widest uppercase mb-4\" data-kid=\"39\">Step 01</span>\n                        <h3 class=\"font-quicksand font-bold text-2xl text-[#343a40] mb-4\" data-kid=\"40\">Login Securely</h3>\n                        <p class=\"text-base text-[#343a40]/90 leading-relaxed font-medium\" data-kid=\"41\">\n                            Use your Model Head credentials to securely access the central registration portal.\n                        </p>\n                    </div>\n                </div>\n\n                \n                <div class=\"lg:px-2 lg:-mr-8 lg:mt-12\" data-kid=\"42\">\n                    <div class=\"step-card h-[460px] bg-white rounded-[40px_140px_40px_140px] border-2 border-dashed border-[#fcc419] shadow-xl shadow-[#fcc419]/5 p-10 flex flex-col items-center text-center\" data-kid=\"43\">\n                        <div class=\"w-20 h-20 rounded-full bg-[#fcc419]/5 flex items-center justify-center mb-8\" data-kid=\"44\">\n                            <i class=\"ti ti-user-plus text-4xl text-[#fcc419]\" data-kid=\"45\"></i>\n                        </div>\n                        <span class=\"text-[#fcc419] font-bold text-xs tracking-widest uppercase mb-4\" data-kid=\"46\">Step 02</span>\n                        <h3 class=\"font-quicksand font-bold text-2xl text-[#343a40] mb-4\" data-kid=\"47\">Submit Details</h3>\n                        <p class=\"text-base text-[#343a40]/90 leading-relaxed font-medium\" data-kid=\"48\">\n                            Add volunteer information, upload their photo, and specify accommodation needs.\n                        </p>\n                    </div>\n                </div>\n\n                \n                <div class=\"lg:px-2 lg:-mr-8\" data-kid=\"49\">\n                    <div class=\"step-card h-[460px] bg-white rounded-[140px_40px_140px_40px] border-2 border-dashed border-[#22b8cf] shadow-xl shadow-[#22b8cf]/5 p-10 flex flex-col items-center text-center\" data-kid=\"50\">\n                        <div class=\"w-20 h-20 rounded-full bg-[#22b8cf]/5 flex items-center justify-center mb-8\" data-kid=\"51\">\n                            <i class=\"ti ti-shield-check text-4xl text-[#22b8cf]\" data-kid=\"52\"></i>\n                        </div>\n                        <span class=\"text-[#22b8cf] font-bold text-xs tracking-widest uppercase mb-4\" data-kid=\"53\">Step 03</span>\n                        <h3 class=\"font-quicksand font-bold text-2xl text-[#343a40] mb-4\" data-kid=\"54\">Admin Approval</h3>\n                        <p class=\"text-base text-[#343a40]/90 leading-relaxed font-medium\" data-kid=\"55\">\n                            The Super Admin will review and verify your submitted volunteer profiles for accuracy.\n                        </p>\n                    </div>\n                </div>\n\n                \n                <div class=\"lg:px-2 lg:mt-12\" data-kid=\"56\">\n                    <div class=\"step-card h-[460px] bg-white rounded-[40px_140px_40px_140px] border-2 border-dashed border-[#be4bdb] shadow-xl shadow-[#be4bdb]/5 p-10 flex flex-col items-center text-center\" data-kid=\"57\">\n                        <div class=\"w-20 h-20 rounded-full bg-[#be4bdb]/5 flex items-center justify-center mb-8\" data-kid=\"58\">\n                            <i class=\"ti ti-printer text-4xl text-[#be4bdb]\" data-kid=\"59\"></i>\n                        </div>\n                        <span class=\"text-[#be4bdb] font-bold text-xs tracking-widest uppercase mb-4\" data-kid=\"60\">Step 04</span>\n                        <h3 class=\"font-quicksand font-bold text-2xl text-[#343a40] mb-4\" data-kid=\"61\">ID Printing</h3>\n                        <p class=\"text-base text-[#343a40]/90 leading-relaxed font-medium\" data-kid=\"62\">\n                            Once approved, the admin generates and prints the official official event badges.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section class=\"py-20\" data-kid=\"63\">\n        <div class=\"max-w-6xl mx-auto px-6\" data-kid=\"64\">\n            <div class=\"relative min-h-[460px] rounded-[250px_60px_250px_60px] overflow-hidden shadow-2xl group border-8 border-white/50 backdrop-blur-sm\" data-kid=\"65\">\n                \n                <img src=\"https://images.unsplash.com/photo-1667184297236-33dfa89016a7?auto=format&w=1400&q=80&fit=crop\" alt=\"Children smiling in traditional joyful attire\" class=\"absolute inset-0 w-full h-full object-cover opacity-25 group-hover:scale-105 transition-transform duration-[2000ms]\" decoding=\"async\" data-kid=\"66\">\n                \n                \n                <div class=\"absolute inset-0 bg-gradient-to-r from-[#fff4e6] via-[#fff4e6]/95 to-transparent\" data-kid=\"67\"></div>\n\n                \n                <div class=\"absolute inset-0 flex flex-col items-center justify-center p-12 text-center lg:items-start lg:text-left lg:pl-32\" data-kid=\"68\">\n                    <h2 class=\"text-5xl md:text-6xl font-quicksand font-bold text-[#343a40] mb-6 leading-tight max-w-xl\" data-kid=\"69\">\n                        Ready to Start the <br data-kid=\"70\"> \n                        <span class=\"text-[#ff8787]\" data-kid=\"71\">Joyful Service?</span>\n                    </h2>\n                    <p class=\"text-xl text-[#343a40]/70 mb-12 max-w-lg font-medium\" data-kid=\"72\">\n                        Help us make the 60th Maharashtra Samagam a grand success by registering your dedicated volunteers today.\n                    </p>\n                    \n                    <button class=\"relative px-16 py-6 bg-white text-[#ff8787] font-extrabold text-2xl rounded-full shadow-[0_30px_80px_rgba(255,135,135,0.3)] hover:-translate-y-2 hover:shadow-[0_40px_100px_rgba(255,135,135,0.4)] transition-all duration-500 group active:scale-95 overflow-hidden\" data-kid=\"73\">\n                        \n                        <div class=\"absolute inset-0 bg-gradient-to-r from-[#ff8787] to-[#fcc419] opacity-0 group-hover:opacity-10 transition-opacity duration-500\" data-kid=\"74\"></div>\n                        \n                        <div class=\"absolute inset-2 border-2 border-dashed border-[#ff8787]/40 rounded-full\" data-kid=\"75\"></div>\n                        <span class=\"relative z-10 flex items-center gap-5\" data-kid=\"76\">\n                            Start the Process\n                            <i class=\"ti ti-arrow-right text-3xl group-hover:translate-x-2 transition-transform duration-300\" data-kid=\"77\"></i>\n                        </span>\n                        \n                        <div class=\"absolute -inset-4 bg-white/20 blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none\" data-kid=\"78\"></div>\n                    </button>\n                </div>\n\n                \n                <div class=\"absolute top-12 right-12 text-[#fcc419]/40 text-7xl animate-bounce hidden md:block\" data-kid=\"79\">\n                    <i class=\"ti ti-sparkles\" data-kid=\"80\"></i>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <footer class=\"bg-white/40 border-t border-white/40 py-12 relative overflow-hidden\" data-kid=\"81\">\n        <div class=\"max-w-7xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-8 text-center md:text-left\" data-kid=\"82\">\n            <div class=\"flex flex-col gap-3\" data-kid=\"83\">\n                <div class=\"flex items-center gap-3 justify-center md:justify-start\" data-kid=\"84\">\n                    <div class=\"w-8 h-8 rounded-lg bg-gradient-to-br from-[#ff8787] to-[#fcc419] flex items-center justify-center shadow-md\" data-kid=\"85\">\n                        <i class=\"ti ti-sparkles text-white text-sm\" data-kid=\"86\"></i>\n                    </div>\n                    <span class=\"font-quicksand font-bold text-xl text-[#343a40]\" data-kid=\"87\">Bal Pradarshani</span>\n                </div>\n                <p class=\"text-sm font-medium text-[#343a40]/40\" data-kid=\"88\">© 2027 Sant Nirankari Mandal. All Rights Reserved.</p>\n            </div>\n\n            <div class=\"flex flex-wrap justify-center gap-8 items-center text-sm font-bold text-[#343a40]/60\" data-kid=\"89\">\n                <a href=\"#\" class=\"hover:text-[#ff8787] transition-colors\" data-kid=\"90\">Official Website</a>\n                <span class=\"hidden md:block w-1 h-1 bg-[#343a40]/10 rounded-full\" data-kid=\"91\"></span>\n                <a href=\"#\" class=\"hover:text-[#ff8787] transition-colors\" data-kid=\"92\">Privacy Policy</a>\n                <span class=\"hidden md:block w-1 h-1 bg-[#343a40]/10 rounded-full\" data-kid=\"93\"></span>\n                <a href=\"#\" class=\"hover:text-[#ff8787] transition-colors\" data-kid=\"94\">Help Desk</a>\n            </div>\n\n            <div class=\"flex gap-4\" data-kid=\"95\">\n                <div class=\"w-10 h-10 rounded-full bg-white border border-[#343a40]/5 flex items-center justify-center text-[#343a40]/40 hover:text-[#ff8787] hover:border-[#ff8787]/20 transition-all cursor-pointer\" data-kid=\"96\">\n                    <i class=\"ti ti-brand-facebook text-xl\" data-kid=\"97\"></i>\n                </div>\n                <div class=\"w-10 h-10 rounded-full bg-white border border-[#343a40]/5 flex items-center justify-center text-[#343a40]/40 hover:text-[#ff8787] hover:border-[#ff8787]/20 transition-all cursor-pointer\" data-kid=\"98\">\n                    <i class=\"ti ti-brand-twitter text-xl\" data-kid=\"99\"></i>\n                </div>\n                <div class=\"w-10 h-10 rounded-full bg-white border border-[#343a40]/5 flex items-center justify-center text-[#343a40]/40 hover:text-[#ff8787] hover:border-[#ff8787]/20 transition-all cursor-pointer\" data-kid=\"100\">\n                    <i class=\"ti ti-brand-instagram text-xl\" data-kid=\"101\"></i>\n                </div>\n            </div>\n        </div>\n    </footer>\n</div>\n",

      "html": "\n<div class=\"bg-[#FDFBF7] text-[#2C1810] font-['Lato'] min-h-[800px] selection:bg-[#C5A059] selection:text-white overflow-hidden relative\" data-kid=\"0\">\n    \n    \n    <div class=\"absolute inset-0 pointer-events-none opacity-[0.03] z-[100]\" style=\"background-image: url('https://images.unsplash.com/photo-1601662528567-526cd06f6582?auto=format&w=1280&q=80&fit=crop'); background-size: cover; background-repeat: no-repeat;\" data-kid=\"1\"></div>\n\n    \n    <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/flower-emblem.svg\" class=\"absolute -top-32 -left-32 w-[500px] h-[500px] opacity-[0.03] rotate-12 pointer-events-none\" style=\"filter: invert(15%) sepia(30%) saturate(1000%) hue-rotate(220deg);\" data-kid=\"2\">\n    <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/flower-emblem.svg\" class=\"absolute top-1/2 -right-32 w-[400px] h-[400px] opacity-[0.02] -rotate-45 pointer-events-none\" style=\"filter: invert(15%) sepia(30%) saturate(1000%) hue-rotate(220deg);\" data-kid=\"3\">\n    <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/flower-emblem.svg\" class=\"absolute -bottom-32 left-1/4 w-[600px] h-[600px] opacity-[0.03] rotate-90 pointer-events-none\" style=\"filter: invert(15%) sepia(30%) saturate(1000%) hue-rotate(220deg);\" data-kid=\"4\">\n\n    \n    <header class=\"relative z-50 border-b border-[#C5A059]/10 bg-white/40 backdrop-blur-sm\" data-kid=\"5\">\n        <div class=\"max-w-7xl mx-auto px-6 h-24 flex items-center justify-between\" data-kid=\"6\">\n            <div class=\"flex items-center gap-4\" data-kid=\"7\">\n                <div class=\"relative group\" data-kid=\"8\">\n                    <div class=\"absolute inset-0 bg-[#C5A059] blur-md opacity-20 group-hover:opacity-40 transition-opacity\" data-kid=\"9\"></div>\n                    <div class=\"relative w-14 h-14 flex items-center justify-center\" data-kid=\"10\">\n                        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/flower-emblem.svg\" class=\"absolute inset-0 w-full h-full opacity-20 scale-125\" style=\"filter: invert(15%) sepia(30%) saturate(1000%) hue-rotate(220deg);\" data-kid=\"11\">\n                        <div class=\"relative w-10 h-10 border border-[#C5A059] flex items-center justify-center bg-white shadow-sm\" data-kid=\"12\">\n                            <i class=\"ti ti-id-badge-2 text-[#2D2A54] text-xl\" data-kid=\"13\"></i>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"flex flex-col\" data-kid=\"14\">\n                    <span class=\"font-serif text-2xl text-[#2D2A54] tracking-tight font-bold\" data-kid=\"15\">Bal Pradarshani</span>\n                    <span class=\"text-[10px] tracking-[0.3em] uppercase text-[#C5A059] font-bold\" data-kid=\"16\">Maharashtra Samagam</span>\n                </div>\n            </div>\n            <nav class=\"hidden md:flex items-center gap-10 text-sm tracking-widest uppercase font-bold text-[#2D2A54]/80\" data-kid=\"17\">\n                <a href=\"#\" class=\"hover:text-[#C5A059] transition-colors\" data-kid=\"18\">Portal Info</a>\n                <a href=\"#\" class=\"hover:text-[#C5A059] transition-colors\" data-kid=\"19\">Guidelines</a>\n                <a href=\"#\" class=\"px-8 py-3 border border-[#C5A059] text-[#C5A059] hover:bg-[#C5A059] hover:text-white transition-all duration-300\" data-kid=\"20\">Sign In</a>\n            </nav>\n        </div>\n    </header>\n\n    <main class=\"relative z-10\" data-kid=\"21\">\n        \n        <section class=\"h-[750px] flex items-center justify-center px-6 relative\" data-kid=\"22\">\n            <div class=\"max-w-5xl w-full text-center\" data-kid=\"23\">\n                \n                <div class=\"relative p-12 md:p-24 border border-[#C5A059]/10\" data-kid=\"24\">\n                    \n                    <div class=\"absolute -top-1 -left-1 w-20 h-20 border-t-4 border-l-4 border-[#C5A059]\" data-kid=\"25\"></div>\n                    <div class=\"absolute -top-1 -right-1 w-20 h-20 border-t-4 border-r-4 border-[#C5A059]\" data-kid=\"26\"></div>\n                    <div class=\"absolute -bottom-1 -left-1 w-20 h-20 border-b-4 border-l-4 border-[#C5A059]\" data-kid=\"27\"></div>\n                    <div class=\"absolute -bottom-1 -right-1 w-20 h-20 border-b-4 border-r-4 border-[#C5A059]\" data-kid=\"28\"></div>\n                    \n                    \n                    <div class=\"absolute inset-4 border border-[#C5A059]/20 pointer-events-none\" data-kid=\"29\"></div>\n\n                    <div class=\"relative z-10 space-y-10\" data-kid=\"30\">\n                        <div class=\"flex items-center justify-center gap-4\" data-kid=\"31\">\n                            <div class=\"h-px w-12 bg-[#C5A059]/40\" data-kid=\"32\"></div>\n                            <span class=\"text-[#C5A059] font-serif italic text-lg\" data-kid=\"33\">Established 2027</span>\n                            <div class=\"h-px w-12 bg-[#C5A059]/40\" data-kid=\"34\"></div>\n                        </div>\n\n                        <h1 class=\"text-6xl md:text-8xl font-serif text-[#2D2A54] leading-[1.1] tracking-tight\" data-kid=\"35\">\n                            How to Navigate the<br data-kid=\"36\">\n                            <span class=\"text-[#C5A059] italic drop-shadow-[0_0_15px_rgba(197,160,89,0.2)]\" data-kid=\"37\">ID Generation Portal</span>\n                        </h1>\n\n                        <p class=\"max-w-2xl mx-auto text-xl text-[#3E2723] font-light leading-relaxed\" data-kid=\"38\">\n                            A ceremonial and structured guide designed for Model Heads to facilitate seamless registration and credentialing for our esteemed volunteers.\n                        </p>\n                        \n                        <div class=\"pt-6\" data-kid=\"39\">\n                            <div class=\"w-16 h-px bg-[#C5A059] mx-auto opacity-40\" data-kid=\"40\"></div>\n                            <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/flower-emblem.svg\" class=\"w-10 h-10 mx-auto mt-4 opacity-30\" style=\"filter: invert(15%) sepia(30%) saturate(1000%) hue-rotate(220deg);\" data-kid=\"41\">\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"py-24 px-6 relative\" data-kid=\"42\">\n            <div class=\"max-w-7xl mx-auto relative\" data-kid=\"43\">\n                \n                <div class=\"hidden md:block absolute left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-[#C5A059]/20 to-transparent -translate-x-1/2\" data-kid=\"44\"></div>\n                \n                <div class=\"flex flex-col gap-20\" data-kid=\"45\">\n                    \n                    \n                    <div class=\"flex flex-col md:flex-row items-center relative\" data-kid=\"46\">\n                        <div class=\"w-full md:w-5/12 relative z-10\" data-kid=\"47\">\n                            \n                            <div class=\"relative bg-white shadow-2xl p-1 border border-[#C5A059]/20 group transition-all duration-700 hover:shadow-[#C5A059]/10\" data-kid=\"48\">\n                                \n                                <div class=\"absolute -left-4 top-1/2 -translate-y-1/2 w-8 h-16 bg-[#FDFBF7] rounded-full border border-[#C5A059]/20 z-20\" data-kid=\"49\"></div>\n                                <div class=\"absolute -right-4 top-1/2 -translate-y-1/2 w-8 h-16 bg-[#FDFBF7] rounded-full border border-[#C5A059]/20 z-20\" data-kid=\"50\"></div>\n                                \n                                <div class=\"border-2 border-[#C5A059]/40 p-10 flex flex-col items-center text-center\" data-kid=\"51\">\n                                    <div class=\"w-20 h-20 mb-8 border-2 border-[#2D2A54] flex items-center justify-center group-hover:bg-[#2D2A54] transition-colors duration-500\" data-kid=\"52\">\n                                        <i class=\"ti ti-door-enter text-4xl text-[#2D2A54] group-hover:text-white transition-colors\" data-kid=\"53\"></i>\n                                    </div>\n                                    <h3 class=\"font-serif text-3xl text-[#2D2A54] mb-4 italic\" data-kid=\"54\">Step 01: Authorization</h3>\n                                    <p class=\"text-[#3E2723]/70 font-sans leading-relaxed text-lg\" data-kid=\"55\">Use your Model Head credentials to access the central administration gateway securely.</p>\n                                    <div class=\"mt-8 flex items-center gap-3\" data-kid=\"56\">\n                                        <div class=\"w-2 h-2 rounded-full bg-[#C5A059]\" data-kid=\"57\"></div>\n                                        <span class=\"text-[#C5A059] font-serif font-bold tracking-widest uppercase text-xs\" data-kid=\"58\">Credential Check</span>\n                                        <div class=\"w-2 h-2 rounded-full bg-[#C5A059]\" data-kid=\"59\"></div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"w-full md:w-2/12 flex items-center justify-center py-8 md:py-0\" data-kid=\"60\">\n                            <div class=\"hidden md:block h-px w-full bg-[#C5A059]/30\" data-kid=\"61\"></div>\n                            <div class=\"md:hidden w-px h-16 bg-[#C5A059]/30\" data-kid=\"62\"></div>\n                        </div>\n                        <div class=\"w-full md:w-5/12 hidden md:block\" data-kid=\"63\"></div>\n                    </div>\n\n                    \n                    <div class=\"flex flex-col md:flex-row-reverse items-center relative\" data-kid=\"64\">\n                        <div class=\"w-full md:w-5/12 relative z-10\" data-kid=\"65\">\n                            <div class=\"relative bg-white shadow-2xl p-1 border border-[#C5A059]/20 group transition-all duration-700 hover:shadow-[#C5A059]/10\" data-kid=\"66\">\n                                <div class=\"absolute -left-4 top-1/2 -translate-y-1/2 w-8 h-16 bg-[#FDFBF7] rounded-full border border-[#C5A059]/20 z-20\" data-kid=\"67\"></div>\n                                <div class=\"absolute -right-4 top-1/2 -translate-y-1/2 w-8 h-16 bg-[#FDFBF7] rounded-full border border-[#C5A059]/20 z-20\" data-kid=\"68\"></div>\n                                \n                                <div class=\"border-2 border-[#C5A059]/40 p-10 flex flex-col items-center text-center\" data-kid=\"69\">\n                                    <div class=\"w-20 h-20 mb-8 border-2 border-[#2D2A54] flex items-center justify-center group-hover:bg-[#2D2A54] transition-colors duration-500\" data-kid=\"70\">\n                                        <i class=\"ti ti-user-check text-4xl text-[#2D2A54] group-hover:text-white transition-colors\" data-kid=\"71\"></i>\n                                    </div>\n                                    <h3 class=\"font-serif text-3xl text-[#2D2A54] mb-4 italic\" data-kid=\"72\">Step 02: Enlistment</h3>\n                                    <p class=\"text-[#3E2723]/70 font-sans leading-relaxed text-lg\" data-kid=\"73\">Input volunteer profiles with meticulous detail. Ensure high-fidelity photographs are uploaded for formal identification.</p>\n                                    <div class=\"mt-8 flex items-center gap-3\" data-kid=\"74\">\n                                        <div class=\"w-2 h-2 rounded-full bg-[#C5A059]\" data-kid=\"75\"></div>\n                                        <span class=\"text-[#C5A059] font-serif font-bold tracking-widest uppercase text-xs\" data-kid=\"76\">Data Entry</span>\n                                        <div class=\"w-2 h-2 rounded-full bg-[#C5A059]\" data-kid=\"77\"></div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"w-full md:w-2/12 flex items-center justify-center py-8 md:py-0\" data-kid=\"78\">\n                            <div class=\"hidden md:block h-px w-full bg-[#C5A059]/30\" data-kid=\"79\"></div>\n                            <div class=\"md:hidden w-px h-16 bg-[#C5A059]/30\" data-kid=\"80\"></div>\n                        </div>\n                        <div class=\"w-full md:w-5/12 hidden md:block\" data-kid=\"81\"></div>\n                    </div>\n\n                    \n                    <div class=\"flex flex-col md:flex-row items-center relative\" data-kid=\"82\">\n                        <div class=\"w-full md:w-5/12 relative z-10\" data-kid=\"83\">\n                            <div class=\"relative bg-white shadow-2xl p-1 border border-[#C5A059]/20 group transition-all duration-700 hover:shadow-[#C5A059]/10\" data-kid=\"84\">\n                                <div class=\"absolute -left-4 top-1/2 -translate-y-1/2 w-8 h-16 bg-[#FDFBF7] rounded-full border border-[#C5A059]/20 z-20\" data-kid=\"85\"></div>\n                                <div class=\"absolute -right-4 top-1/2 -translate-y-1/2 w-8 h-16 bg-[#FDFBF7] rounded-full border border-[#C5A059]/20 z-20\" data-kid=\"86\"></div>\n                                \n                                <div class=\"border-2 border-[#C5A059]/40 p-10 flex flex-col items-center text-center\" data-kid=\"87\">\n                                    <div class=\"w-20 h-20 mb-8 border-2 border-[#2D2A54] flex items-center justify-center group-hover:bg-[#2D2A54] transition-colors duration-500\" data-kid=\"88\">\n                                        <i class=\"ti ti-checks text-4xl text-[#2D2A54] group-hover:text-white transition-colors\" data-kid=\"89\"></i>\n                                    </div>\n                                    <h3 class=\"font-serif text-3xl text-[#2D2A54] mb-4 italic\" data-kid=\"90\">Step 03: Verification</h3>\n                                    <p class=\"text-[#3E2723]/70 font-sans leading-relaxed text-lg\" data-kid=\"91\">The Super Admin reviews and validates each profile, ensuring alignment with organizational standards.</p>\n                                    <div class=\"mt-8 flex items-center gap-3\" data-kid=\"92\">\n                                        <div class=\"w-2 h-2 rounded-full bg-[#C5A059]\" data-kid=\"93\"></div>\n                                        <span class=\"text-[#C5A059] font-serif font-bold tracking-widest uppercase text-xs\" data-kid=\"94\">Quality Assurance</span>\n                                        <div class=\"w-2 h-2 rounded-full bg-[#C5A059]\" data-kid=\"95\"></div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"w-full md:w-2/12 flex items-center justify-center py-8 md:py-0\" data-kid=\"96\">\n                            <div class=\"hidden md:block h-px w-full bg-[#C5A059]/30\" data-kid=\"97\"></div>\n                            <div class=\"md:hidden w-px h-16 bg-[#C5A059]/30\" data-kid=\"98\"></div>\n                        </div>\n                        <div class=\"w-full md:w-5/12 hidden md:block\" data-kid=\"99\"></div>\n                    </div>\n\n                    \n                    <div class=\"flex flex-col md:flex-row-reverse items-center relative\" data-kid=\"100\">\n                        <div class=\"w-full md:w-5/12 relative z-10\" data-kid=\"101\">\n                            <div class=\"relative bg-white shadow-2xl p-1 border border-[#C5A059]/20 group transition-all duration-700 hover:shadow-[#C5A059]/10\" data-kid=\"102\">\n                                <div class=\"absolute -left-4 top-1/2 -translate-y-1/2 w-8 h-16 bg-[#FDFBF7] rounded-full border border-[#C5A059]/20 z-20\" data-kid=\"103\"></div>\n                                <div class=\"absolute -right-4 top-1/2 -translate-y-1/2 w-8 h-16 bg-[#FDFBF7] rounded-full border border-[#C5A059]/20 z-20\" data-kid=\"104\"></div>\n                                \n                                <div class=\"border-2 border-[#C5A059]/40 p-10 flex flex-col items-center text-center\" data-kid=\"105\">\n                                    <div class=\"w-20 h-20 mb-8 border-2 border-[#2D2A54] flex items-center justify-center group-hover:bg-[#2D2A54] transition-colors duration-500\" data-kid=\"106\">\n                                        <i class=\"ti ti-printer text-4xl text-[#2D2A54] group-hover:text-white transition-colors\" data-kid=\"107\"></i>\n                                    </div>\n                                    <h3 class=\"font-serif text-3xl text-[#2D2A54] mb-4 italic\" data-kid=\"108\">Step 04: Issuance</h3>\n                                    <p class=\"text-[#3E2723]/70 font-sans leading-relaxed text-lg\" data-kid=\"109\">Upon final approval, credentials are generated and printed. The tangible symbol of service is now ready.</p>\n                                    <div class=\"mt-8 flex items-center gap-3\" data-kid=\"110\">\n                                        <div class=\"w-2 h-2 rounded-full bg-[#C5A059]\" data-kid=\"111\"></div>\n                                        <span class=\"text-[#C5A059] font-serif font-bold tracking-widest uppercase text-xs\" data-kid=\"112\">Badge Generation</span>\n                                        <div class=\"w-2 h-2 rounded-full bg-[#C5A059]\" data-kid=\"113\"></div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"w-full md:w-2/12 flex items-center justify-center py-8 md:py-0\" data-kid=\"114\">\n                            <div class=\"hidden md:block h-px w-full bg-[#C5A059]/30\" data-kid=\"115\"></div>\n                            <div class=\"md:hidden w-px h-16 bg-[#C5A059]/30\" data-kid=\"116\"></div>\n                        </div>\n                        <div class=\"w-full md:w-5/12 hidden md:block\" data-kid=\"117\"></div>\n                    </div>\n\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"py-24 px-6\" data-kid=\"118\">\n            <div class=\"max-w-5xl mx-auto\" data-kid=\"119\">\n                <div class=\"bg-[#2D2A54] relative p-12 md:p-24 overflow-hidden shadow-[0_50px_100px_-20px_rgba(45,42,84,0.3)]\" data-kid=\"120\">\n                    \n                    <div class=\"absolute inset-0 opacity-[0.03] pointer-events-none mix-blend-overlay\" style=\"background-image: url('https://images.unsplash.com/photo-1601662528567-526cd06f6582?auto=format&w=1280&q=80&fit=crop');\" data-kid=\"121\"></div>\n                    \n                    \n                    <div class=\"absolute inset-6 border border-[#C5A059]/30 pointer-events-none\" data-kid=\"122\"></div>\n                    <div class=\"absolute inset-8 border border-[#C5A059]/10 pointer-events-none\" data-kid=\"123\"></div>\n\n                    \n                    <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/flower-emblem.svg\" class=\"absolute top-6 left-6 w-16 h-16 opacity-20\" style=\"filter: invert(80%) sepia(50%) saturate(500%) hue-rotate(10deg);\" data-kid=\"124\">\n                    <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/flower-emblem.svg\" class=\"absolute top-6 right-6 w-16 h-16 opacity-20\" style=\"filter: invert(80%) sepia(50%) saturate(500%) hue-rotate(10deg);\" data-kid=\"125\">\n                    <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/flower-emblem.svg\" class=\"absolute bottom-6 left-6 w-16 h-16 opacity-20\" style=\"filter: invert(80%) sepia(50%) saturate(500%) hue-rotate(10deg);\" data-kid=\"126\">\n                    <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/flower-emblem.svg\" class=\"absolute bottom-6 right-6 w-16 h-16 opacity-20\" style=\"filter: invert(80%) sepia(50%) saturate(500%) hue-rotate(10deg);\" data-kid=\"127\">\n\n                    <div class=\"relative z-10 text-center space-y-12\" data-kid=\"128\">\n                        <div class=\"space-y-4\" data-kid=\"129\">\n                            <span class=\"text-[#C5A059] font-sans tracking-[0.4em] uppercase text-xs font-black\" data-kid=\"130\">Call to Service</span>\n                            <h2 class=\"text-5xl md:text-7xl font-serif text-white italic leading-tight\" data-kid=\"131\">Begin the Process</h2>\n                        </div>\n                        \n                        <p class=\"text-white/70 font-sans text-xl max-w-2xl mx-auto font-light leading-relaxed\" data-kid=\"132\">\n                            Access the portal now to register your volunteers. Your contribution ensures the grandeur and discipline of the 60th Maharashtra Samagam.\n                        </p>\n                        \n                        <div class=\"pt-8\" data-kid=\"133\">\n                            <button class=\"group relative inline-flex items-center justify-center gap-6 bg-[#C5A059] text-[#2D2A54] px-16 py-7 font-sans font-black text-xl tracking-[0.2em] uppercase transition-all duration-300 hover:scale-[1.02] shadow-[8px_8px_0_0_#1a1738] cursor-pointer\" data-kid=\"134\">\n                                <span data-kid=\"135\">Enter the Portal</span>\n                                <i class=\"ti ti-circle-arrow-right text-3xl transition-transform group-hover:translate-x-2\" data-kid=\"136\"></i>\n                                \n                                <div class=\"absolute inset-1 border-2 border-[#2D2A54]/10 pointer-events-none\" data-kid=\"137\"></div>\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n\n    \n    <footer class=\"bg-white/40 backdrop-blur-md border-t border-[#C5A059]/20 py-16 relative z-10\" data-kid=\"138\">\n        <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"139\">\n            <div class=\"flex flex-col items-center gap-10\" data-kid=\"140\">\n                <div class=\"flex items-center gap-4 grayscale opacity-60 group\" data-kid=\"141\">\n                    <div class=\"relative w-12 h-12 flex items-center justify-center\" data-kid=\"142\">\n                        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/flower-emblem.svg\" class=\"absolute inset-0 w-full h-full opacity-40\" style=\"filter: invert(15%) sepia(30%) saturate(1000%) hue-rotate(220deg);\" data-kid=\"143\">\n                        <div class=\"relative w-8 h-8 border border-[#2D2A54] flex items-center justify-center\" data-kid=\"144\">\n                            <i class=\"ti ti-id-badge-2 text-[#2D2A54]\" data-kid=\"145\"></i>\n                        </div>\n                    </div>\n                    <span class=\"font-serif text-xl font-bold text-[#2D2A54]\" data-kid=\"146\">Bal Pradarshani 2027</span>\n                </div>\n                \n                \n                <div class=\"flex items-center gap-6 w-full max-w-md\" data-kid=\"147\">\n                    <div class=\"h-px grow bg-gradient-to-r from-transparent to-[#C5A059]/40\" data-kid=\"148\"></div>\n                    <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/flower-emblem.svg\" class=\"w-6 h-6 opacity-30\" style=\"filter: invert(15%) sepia(30%) saturate(1000%) hue-rotate(220deg);\" data-kid=\"149\">\n                    <div class=\"h-px grow bg-gradient-to-l from-transparent to-[#C5A059]/40\" data-kid=\"150\"></div>\n                </div>\n\n                <div class=\"flex flex-wrap justify-center gap-x-12 gap-y-4 text-xs font-bold tracking-widest uppercase text-[#3E2723]/60\" data-kid=\"151\">\n                    <a href=\"#\" class=\"hover:text-[#C5A059] transition-colors\" data-kid=\"152\">Privacy Charter</a>\n                    <a href=\"#\" class=\"hover:text-[#C5A059] transition-colors\" data-kid=\"153\">Terms of Issuance</a>\n                    <a href=\"#\" class=\"hover:text-[#C5A059] transition-colors\" data-kid=\"154\">Nirankari Official</a>\n                </div>\n\n                <p class=\"text-[10px] tracking-[0.2em] uppercase text-[#3E2723]/40 font-bold text-center\" data-kid=\"155\">\n                    &copy; 2027 Sant Nirankari Mandal. All Sanctified Rights Reserved.\n                </p>\n            </div>\n        </div>\n    </footer>\n\n</div>\n\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"156\">\n<style data-kid=\"157\">\n    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&family=Lato:ital,wght@0,300;0,400;0,700;0,900;1,400&display=swap');\n    \n    .font-serif { font-family: 'Playfair Display', serif; }\n    .font-sans { font-family: 'Lato', sans-serif; }\n\n    /* Custom Scrollbar for premium feel */\n    ::-webkit-scrollbar {\n        width: 8px;\n    }\n    ::-webkit-scrollbar-track {\n        background: #FDFBF7;\n    }\n    ::-webkit-scrollbar-thumb {\n        background: #C5A059;\n        border-radius: 0;\n    }\n</style>\n",
